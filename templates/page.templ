package templates

templ Page() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content="Péter Szarvas. From systems administration to full-stack development. Building simple software that works."/>
			<title>Péter Szarvas</title>
			<meta name="color-scheme" content="light dark"/>
			<script>
				try {
					const saved = localStorage.getItem("portfolio-color-scheme");
					if (saved === "light" || saved === "dark")
						document.querySelector('meta[name="color-scheme"]').content = saved;
				} catch {}
			</script>
			<script src="/static/theme.js" defer></script>
			<link rel="preload" href="/static/fonts/CourierPrime-Regular.ttf" as="font" type="font/ttf" crossorigin/>
			<link rel="stylesheet" href="/static/style.css"/>
		</head>
		<body>
			<a class="skip-link" href="#content">Skip to content</a>
			<nav class="page-nav" aria-label="Resume and appearance">
				<div class="resume-actions">
					<a href="/resume.pdf" download="Peter-Szarvas-resume.pdf">Save resume</a>
					<button type="button" onclick="window.print()">Print resume</button>
				</div>
				<label class="theme-control" hidden>
					Theme
					<select id="theme"><option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option></select>
				</label>
			</nav>
			<main id="content" class="paper">
				<header class="identity">
					<h1>Péter Szarvas</h1>
					<p class="intro">I build software. And the things around it.</p>
					<address>
						<a href="mailto:contact@peterszarvas.hu">contact@peterszarvas.hu</a>
						<a href="https://github.com/peterszarvas94">github.com/peterszarvas94</a>
						<a href="https://www.linkedin.com/in/peterszarvas94/">linkedin.com/in/peterszarvas94</a>
					</address>
				</header>
				@Career()
				<div class="home-extra">
					<section aria-labelledby="projects-heading">
						<h2 id="projects-heading">a few things I've built</h2>
						<ul class="projects">
							<li><a href="https://bandcash.app">Bandcash</a><p>Events, expenses and fair payouts for music bands.</p></li>
							<li><a href="https://szarvaspongrac.hu">Pongrác Szarvas</a><p>An artist's portfolio. A place for the work to speak.</p></li>
							<li><a href="https://szeremletanc.hu">Szeremle</a><p>A home on the web for a folk dance group.</p></li>
							<li><a href="https://pantlikazenekar.hu">Pántlika</a><p>A website for a folk music band.</p></li>
							<li><a href="https://github.com/peterszarvas94/weddingsite">Wedding invitation</a><p>A small website for a big day.</p></li>
						</ul>
					</section>
					<section class="lore" aria-labelledby="lore-heading">
						<h2 id="lore-heading">a little more of the story</h2>
						<p>I started with servers, moved into applications, and kept wanting to understand the whole thing. These days that means building the interface, writing the backend, and keeping it running.</p>
						<p>I like simple code and small tools. Go, server-rendered HTML, and fewer moving parts when they do the job. React and TypeScript when they fit.</p>
						<p>Bandcash brings that thinking to the world of music bands: less time untangling who owes what, more time for the music.</p>
						<p>On my reading list: <a href="https://hypermedia.systems/">Hypermedia Systems</a>, <a href="https://grugbrain.dev/">The Grug Brained Developer</a>, and <a href="https://www.oreilly.com/library/view/we-programmers-a/9780135344248/">We, Programmers</a>.</p>
					</section>
					<footer><p>Have something in mind? <a href="mailto:contact@peterszarvas.hu">Let's talk.</a></p></footer>
				</div>
			</main>
		</body>
	</html>
}

templ Arrow() {
	<span class="arrow" aria-hidden="true">
		<svg viewBox="0 0 24 14" fill="none"><path d="M2 2 L12 12 L22 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
	</span>
}

templ Career() {
	<ol class="career" aria-label="My path">
		<li class="stage">
			<h2>system administrator</h2>
			<div class="stage-body">
				@Arrow()
				<div class="jobs">
					<section class="job" aria-labelledby="ibm-heading">
						<h3 id="ibm-heading">IBM / Kyndryl <span>2020–2022</span></h3>
						<ul><li>Managed Windows servers and hybrid Microsoft Azure environments.</li><li>Learned to keep things running, not just get them running.</li></ul>
					</section>
				</div>
			</div>
		</li>
		<li class="stage">
			<h2>fullstack developer</h2>
			<div class="stage-body">
				@Arrow()
				<div class="jobs">
					<section class="job" aria-labelledby="kyndryl-heading">
						<h3 id="kyndryl-heading">Kyndryl <span>2022–2024</span></h3>
						<ul><li>Built an internal business lead tracker in a two-person team.</li><li>React, JavaScript and Java.</li></ul>
					</section>
					<section class="job" aria-labelledby="eviden-heading">
						<h3 id="eviden-heading">Eviden / Atos <span>2024–present</span></h3>
						<ul><li>Building a government application in an international team.</li><li>React, TypeScript, Node.js and NestJS.</li></ul>
					</section>
				</div>
			</div>
		</li>
		<li class="stage">
			<h2>agentic programmer / designer / devops</h2>
			<div class="stage-body">
				@Arrow()
				<div class="jobs">
					<section class="job" aria-labelledby="bandcash-heading">
						<h3 id="bandcash-heading"><a href="https://bandcash.app">Bandcash</a></h3>
						<p class="aside">Independent work, alongside my day job.</p>
						<ul><li>Building and operating a payment splitting app for music bands.</li><li>Go, templ, Datastar, SQLite. From the first screen to deployment, with AI in the workflow.</li></ul>
					</section>
				</div>
			</div>
			<p class="next"><a href="mailto:contact@peterszarvas.hu">[Your company?]</a><span>Something useful, built together.</span></p>
		</li>
	</ol>
}
